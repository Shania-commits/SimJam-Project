--- !u!114 &2140913002
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2140913001}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c6be767fd63942fc8c5cb76a39f65306, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_steps:
  - title: Welcome
    caption: 'Welcome to the

      Nuclear Detection Training Simulation


      A
      Virtual Reality Training Simulation'
    backgroundImage: {fileID: 0}
    narrationClip: {fileID: 8300000, guid: 70ba9d80febdc413dab6ccaa8cba12da, type: 3}
    nextButtonLabel: Begin Your Training
    canGoBack: 0
    canPause: 1
    requireCompletionToContinue: 0
    onStepStarted:
      m_PersistentCalls:
        m_Calls: []
    onStepCompleted:
      m_PersistentCalls:
        m_Calls: []
  - title: Introduction
    caption: 'Radiation detection equipment is used to inspect containers and identify
      radioactive materials.


      In this simulation, you will learn how to use
      an IdentifINDER detector to inspect containers and identify elevated radiation
      levels.


      This experience is a simplified training environment designed
      to introduce the inspection process.'
    backgroundImage: {fileID: 0}
    narrationClip: {fileID: 8300000, guid: c5b5ba900bc294e6e95786f52bfe663d, type: 3}
    nextButtonLabel: Continue
    canGoBack: 1
    canPause: 1
    requireCompletionToContinue: 0
    onStepStarted:
      m_PersistentCalls:
        m_Calls: []
    onStepCompleted:
      m_PersistentCalls:
        m_Calls: []
  - title: Tutorial Overview
    caption: 'Before beginning the mission, you will practice the basics:


      -
      Teleporting around the room

      - Picking up and using the detector

      -
      Reading radiation levels

      - Submitting the barrel you think is correct'
    backgroundImage: {fileID: 0}
    narrationClip: {fileID: 8300000, guid: 383b08e187c5b46fca634905be1ee3c5, type: 3}
    nextButtonLabel: Continue
    canGoBack: 1
    canPause: 1
    requireCompletionToContinue: 0
    onStepStarted:
      m_PersistentCalls:
        m_Calls: []
    onStepCompleted:
      m_PersistentCalls:
        m_Calls: []
  - title: 'Tutorial: Teleportation'
    caption: 'Movement is teleport-only.


      Point either controller at the ground
      to place the teleport marker. A green dot means you can go there. A red dot
      means you cannot go there. Click the back trigger on either controller to teleport.'
    backgroundImage: {fileID: 0}
    narrationClip: {fileID: 8300000, guid: 56c921af3a4db47c1a1258b7dce06660, type: 3}
    nextButtonLabel: Continue
    canGoBack: 1
    canPause: 1
    requireCompletionToContinue: 1
    onStepStarted:
      m_PersistentCalls:
        m_Calls: []
    onStepCompleted:
      m_PersistentCalls:
        m_Calls: []
  - title: 'Tutorial: Teleport Practice'
    caption: 'Point at the floor near the highlighted marker. When the dot turns
      green, click the back trigger on either controller.


      Teleport once to
      continue.'
    backgroundImage: {fileID: 0}
    narrationClip: {fileID: 8300000, guid: df5a783ee3d7c400b8a46ac057ad532a, type: 3}
    nextButtonLabel: Continue
    canGoBack: 1
    canPause: 1
    requireCompletionToContinue: 1
    onStepStarted:
      m_PersistentCalls:
        m_Calls: []
    onStepCompleted:
      m_PersistentCalls:
        m_Calls: []
  - title: 'Tutorial: Detector Operations'
    caption: 'Move your controller near the IdentiFINDER and hold the back trigger
      to pick it up.


      Wave the detector around the barrels and move it toward
      the area where you think the radioactive material is located. The readings
      appear automatically. In the mission, press A when you believe you have found
      the correct barrel.'
    backgroundImage: {fileID: 0}
    narrationClip: {fileID: 8300000, guid: d5411309908034040aa0b77d4590b5a6, type: 3}
    nextButtonLabel: Continue
    canGoBack: 1
    canPause: 1
    requireCompletionToContinue: 1
    onStepStarted:
      m_PersistentCalls:
        m_Calls: []
    onStepCompleted:
      m_PersistentCalls:
        m_Calls: []
  - title: Tutorial Complete
    caption: 'You have completed the basic inspection tutorial.


      Review the
      mission briefing before entering the container inspection room.'
    backgroundImage: {fileID: 0}
    narrationClip: {fileID: 8300000, guid: cac636898f2114110b01aafd0781ff4f, type: 3}
    nextButtonLabel: Mission Briefing
    canGoBack: 1
    canPause: 1
    requireCompletionToContinue: 0
    onStepStarted:
      m_PersistentCalls:
        m_Calls: []
    onStepCompleted:
      m_PersistentCalls:
        m_Calls: []
  - title: Mission Briefing
    caption: 'You will have 3 minutes to inspect the containers using the IdentiFINDER
      detector.


      Wave the detector around the barrels and follow the readings
      toward the suspected radioactive material. When you believe you have found
      the correct barrel, aim at it and press A to submit.'
    backgroundImage: {fileID: 0}
    narrationClip: {fileID: 8300000, guid: dc6b757df45b74b81a1f7891f351c8ef, type: 3}
    nextButtonLabel: Begin Mission
    canGoBack: 1
    canPause: 1
    requireCompletionToContinue: 0
    onStepStarted:
      m_PersistentCalls:
        m_Calls: []
    onStepCompleted:
      m_PersistentCalls:
        m_Calls: []
