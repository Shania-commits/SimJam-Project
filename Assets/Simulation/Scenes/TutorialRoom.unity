MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2140913001}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c6be767fd63942fc8c5cb76a39f65306, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_steps:
  - title: Welcome
    caption: 'Welcome to the

      Nuclear Detection Training Simulation


      A
      Virtual Reality Training Simulation'
    backgroundImage: {fileID: 0}
    nextButtonLabel: Begin Your Training
    canGoBack: 0
    canPause: 1
    requireCompletionToContinue: 0
    onStepStarted:
      m_PersistentCalls:
        m_Calls: []
    onStepCompleted:
      m_PersistentCalls:
        m_Calls: []
  - title: Introduction
    caption: 'Radiation detection equipment is used to inspect containers and identify
      radioactive materials.


      In this simulation, you will learn how to use
      an IdentifINDER detector to inspect containers and identify elevated radiation
      levels.


      This experience is a simplified training environment designed
      to introduce the inspection process.'
    backgroundImage: {fileID: 0}
    nextButtonLabel: Continue
    canGoBack: 1
    canPause: 1
    requireCompletionToContinue: 0
    onStepStarted:
      m_PersistentCalls:
        m_Calls: []
    onStepCompleted:
      m_PersistentCalls:
        m_Calls: []
  - title: Tutorial Overview
    caption: 'Before beginning the mission, you will complete a brief tutorial covering:


      -
      Movement

      - Teleportation

      - Operating the detector

      - Understanding
      the barrel readings'
    backgroundImage: {fileID: 0}
    nextButtonLabel: Continue
    canGoBack: 1
    canPause: 1
    requireCompletionToContinue: 0
    onStepStarted:
      m_PersistentCalls:
        m_Calls: []
    onStepCompleted:
      m_PersistentCalls:
        m_Calls: []
  - title: 'Tutorial: Movement'
    caption: 'Use your controller to move through the environment.


      Walk to
      the highlighted marker to continue.'
    backgroundImage: {fileID: 0}
    nextButtonLabel: Continue
    canGoBack: 1
    canPause: 1
    requireCompletionToContinue: 1
    onStepStarted:
      m_PersistentCalls:
        m_Calls: []
    onStepCompleted:
      m_PersistentCalls:
        m_Calls: []
  - title: 'Tutorial: Teleportation'
    caption: 'Aim at the floor with your right controller and press the right trigger
      to teleport.


      Teleport to continue.'
    backgroundImage: {fileID: 0}
    nextButtonLabel: Continue
    canGoBack: 1
    canPause: 1
    requireCompletionToContinue: 1
    onStepStarted:
      m_PersistentCalls:
        m_Calls: []
    onStepCompleted:
      m_PersistentCalls:
        m_Calls: []
  - title: 'Tutorial: Detector Operations'
    caption: 'Hold the grip button near the IdentiFINDER to pick it up.


      Point
      it at a barrel and watch the reading change to continue.'
    backgroundImage: {fileID: 0}
    nextButtonLabel: Continue
    canGoBack: 1
    canPause: 1
    requireCompletionToContinue: 1
    onStepStarted:
      m_PersistentCalls:
        m_Calls: []
    onStepCompleted:
      m_PersistentCalls:
        m_Calls: []
  - title: Tutorial Complete
    caption: 'You have completed the basic inspection tutorial.


      Review the
      mission briefing before entering the container inspection room.'
    backgroundImage: {fileID: 0}
    nextButtonLabel: Mission Briefing
    canGoBack: 1
    canPause: 1
    requireCompletionToContinue: 0
    onStepStarted:
      m_PersistentCalls:
        m_Calls: []
    onStepCompleted:
      m_PersistentCalls:
        m_Calls: []
  - title: Mission Briefing
    caption: 'You will have 3 minutes to inspect the containers using the IdentiFINDER
      detector.


      Radiation levels are randomized across each barrel in the
      room. Compare detector readings across all containers and determine which container
      exhibits the highest radiation level.'
    backgroundImage: {fileID: 0}
    nextButtonLabel: Begin Mission
    canGoBack: 1
    canPause: 1
    requireCompletionToContinue: 0
    onStepStarted:
      m_PersistentCalls:
        m_Calls: []
    onStepCompleted:
      m_PersistentCalls:
        m_Calls: []
  m_startingStepIndex: 0
